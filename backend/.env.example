# Copy this file to .env in the same folder and fill in your own keys.
# See backend/README section "API keys" for how to get each one and which are free.

# Required — powers resume tailoring + job-match scoring (free tier)
GROQ_API_KEY=

# Optional — powers the company-research snapshot (free tier)
TAVILY_API_KEY=

# Optional — powers automatic job discovery from Adzuna (free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional — Remotive needs no key, it's on automatically.

# Optional — powers automatic job discovery from Jooble (free tier)
JOOBLE_API_KEY=

# Optional — powers automatic job discovery from JSearch/RapidAPI, which
# aggregates Google for Jobs results (includes LinkedIn/Indeed/Naukri-sourced
# postings via licensed aggregation, not scraping). Free tier is small, paid
# tiers scale up. Get a key at rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Optional — powers Google Jobs search (aggregates Glassdoor, LinkedIn, Indeed listings).
# Free tier: 100 searches/month. Get key at: https://serpapi.com/
SERPAPI_KEY=

# Optional — powers job discovery from Findwork (developer-focused global jobs).
# Free tier: 50 requests/day. Get key at: https://findwork.dev/developers/
FINDWORK_API_KEY=

# Optional — powers job discovery from The Muse (company culture + tech roles).
# Free tier: generous/unlimited for personal use. Get key at: https://www.themuse.com/developers/api/v2
THE_MUSE_API_KEY=

# No key required — Arbeitnow (European + remote tech jobs) is ON automatically.
# No key required — Jobicy (remote developer/engineering jobs) is ON automatically.

# Any of the above job-source keys can be added independently — GET
# /api/discover/sources shows which are currently active.

# Optional — powers "email me this application" (free, uses your own Gmail)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Backend URL — used in email links (default: http://localhost:8000)
# Change this if you deploy or use ngrok.
BACKEND_URL=http://localhost:8000

# GitHub monitoring — polls your repos and notifies you when a new project
# is detected so you can add it to your resume with one click.
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_POLL_INTERVAL_MINUTES=30

# Auto-apply pipeline — OFF by default. When enabled, matches scoring >= the
# threshold below from Lever/Greenhouse postings (the only two portals with a
# legitimate public apply API) are submitted with ZERO manual review, on a
# schedule. LinkedIn/Naukri/Indeed/etc are NEVER touched by this — they always
# stay prepare-and-open-manually, because scripting those logins risks a ban.
# You must also fill in that portal's profile and tick "Enable connector" on
# the Job Portals page before it will actually apply anywhere.
AUTO_APPLY_ENABLED=false
AUTO_APPLY_MIN_SCORE=75
DISCOVERY_POLL_INTERVAL_MINUTES=60

# Inbox status scanner — reads your own inbox (via IMAP, same Gmail app
# password as above) to detect interview/offer/rejection replies for
# applications you're tracking, and emails you a summary either way. Turns on
# automatically once EMAIL_ADDRESS/EMAIL_APP_PASSWORD are set — no separate
# credential needed. Never sends anything to anyone; read-only on your inbox.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
INBOX_SCAN_INTERVAL_MINUTES=20
INBOX_SCAN_MAX_EMAILS=50

# Portal credentials — stored locally, only sent to the portal itself.
# These are optional and used by the connector system to pre-fill apply forms
# where automation is possible.
LINKEDIN_EMAIL=
NAUKRI_EMAIL=
INDEED_EMAIL=
